# UNPACK a string from an int n of about 7 * 2^N bits. The typechecker
# rejects n with `InvalidValueForType`, whose payload is n.
# This is a regression test for ENG-99.

input
  {
    # N such that the Zarith encoding of n has 2^N + 2 bytes. The gas limit
    # allows N up to 25. With N = 22, the test stays fast, but a decimal
    # conversion of n would take minutes.
    Stack_elt int 22;
  };
output Gas_exhaustion;
code
  {
    # Build the body of the Zarith encoding: 0xff repeated 2^N times.
    PUSH bytes 0xff;
    SWAP;
    PUSH bool True;
    LOOP
      {
        PUSH int -1;
        ADD;
        SWAP;
        DUP;
        CONCAT;
        SWAP;
        DUP;
        GT
      };
    DROP;
    # Close the Zarith encoding with 0x7f (last byte).
    PUSH bytes 0x7f;
    SWAP;
    CONCAT;
    # Prefix: 0x05 (packed data) 00 (int node) bf (first byte of a positive
    # Zarith).
    PUSH bytes 0x0500bf;
    CONCAT;
    UNPACK string;
    DROP
  }
